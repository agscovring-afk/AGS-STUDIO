from .agent_registry import registry



class AgentRouter:


    def resolve(self, task):

        name = task.name.lower()



        if "database" in name:

            return registry.get("code")



        if "module" in name:

            return registry.get("code")



        if "generate" in name:

            return registry.get("code")



        if "analyze" in name:

            return registry.get("code")



        return None




    def execute(self, task):

        agent = self.resolve(task)



        if not agent:

            return {
                "status": "no_agent",
                "task": task.name
            }



        return agent.build(
            task.description
        )



router = AgentRouter()