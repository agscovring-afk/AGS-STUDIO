import json
from pathlib import Path
from datetime import datetime


class KnowledgeStore:


    def __init__(self):

        self.file = Path(
            "data/knowledge_store.json"
        )

        self.file.parent.mkdir(
            exist_ok=True
        )

        self.knowledge = []

        self.load()


    def load(self):

        if self.file.exists():

            try:
                with open(
                    self.file,
                    "r",
                    encoding="utf-8"
                ) as f:

                    self.knowledge = json.load(f)

            except Exception:

                self.knowledge = []


    def save(self):

        with open(
            self.file,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                self.knowledge,
                f,
                indent=4,
                ensure_ascii=False
            )


    def store(self, item):

        entry = {

            "timestamp":
                datetime.now().isoformat(),

            "data": item
        }

        self.knowledge.append(entry)

        self.save()

        return entry


    def store_execution(
        self,
        task,
        result
    ):

        return self.store({

            "type":
                "execution_result",

            "task":
                task,

            "result":
                result
        })


    def search(
        self,
        keyword=None
    ):

        if not keyword:

            return self.knowledge


        results=[]


        for item in self.knowledge:

            if keyword.lower() in str(item).lower():

                results.append(item)


        return results



store = KnowledgeStore()
